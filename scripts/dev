#!/usr/bin/env bash
# 同时启动后端和 Vite，任一退出或按 Ctrl-C 时一起结束。在容器里执行。
# 后端的 Rust 代码有改动时自动重新编译并重启；前端由 Vite 热更新。
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

trap 'kill 0' EXIT

# 刚克隆下来时还没有前端的依赖：先装上
[ -d "$root/client/node_modules" ] || (cd "$root/client" && pnpm install --frozen-lockfile)

(cd "$root/server" && watchexec --restart --watch crates --watch Cargo.toml --exts rs,toml -- cargo run -p vibechat-server) &
(cd "$root/client" && pnpm dev) &

wait -n
